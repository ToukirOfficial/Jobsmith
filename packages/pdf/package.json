{
  "name": "@jobsmith/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@jobsmith/shared": "workspace:*",
    "@react-pdf/renderer": "^4.9.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/node": "^24.0.0"
  }
}
