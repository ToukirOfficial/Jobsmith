{
  "name": "jobsmith",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @jobsmith/api db:migrate",
    "db:seed": "pnpm --filter @jobsmith/api db:seed",
    "sponsors:import": "pnpm --filter @jobsmith/api sponsors:import",
    "db:reset": "pnpm --filter @jobsmith/api db:reset",
    "worker": "pnpm --filter @jobsmith/api worker",
    "evals": "pnpm --filter @jobsmith/api evals",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "scan": "bash scripts/scan-secrets.sh --all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
