# Copy to deploy.env (gitignored) and fill in. deploy.sh reads everything about the server from here;
# nothing about the server is committed.

# SSH host or alias from ~/.ssh/config.
HOST=my-server
# The Linux user that owns and runs the site (the SSH login itself, or a user it can sudo to).
SITE_USER=example-site-user
# Where releases live: $APP_DIR/releases/<id>, $APP_DIR/current, $APP_DIR/shared/{api.env,web.env}
APP_DIR=/home/example-site-user/app
# Database dumps taken before migrations (the newest 5 are kept).
BACKUPS_DIR=/home/example-site-user/backups
# PostgreSQL database name on the server.
DB_NAME=example_db
# Public URL, used for the health checks.
URL=https://jobs.example.com
# Ports on the server (must match the nginx vhost; the API port must match API_PORT in shared/api.env).
WEB_PORT=3000
API_PORT=4000
# Prefix for the PM2 process names (<prefix>-web, <prefix>-api, <prefix>-worker).
PM2_PREFIX=jobsmith
# Optional: the branch the server clones (default main).
# BRANCH=main
