# Jobsmith settings. Copy to .env and fill in. Never commit .env.

# --- Web and API ---
APP_URL=http://localhost:8035
WEB_PORT=8035
API_PORT=8135
API_HOST=127.0.0.1
# Where Next.js forwards /api/* (the NestJS API).
API_INTERNAL_URL=http://127.0.0.1:8135

# --- Database and Redis ---
DATABASE_URL=postgresql://jobsmith:change-me@127.0.0.1:5432/jobsmith
# Tests only: a database whose name ends in _test (it is wiped on every test run).
TEST_DATABASE_URL=postgresql://jobsmith:change-me@127.0.0.1:5432/jobsmith_test
REDIS_URL=redis://127.0.0.1:6379/5
REDIS_PREFIX=jobsmith

# --- Secrets (generate with: openssl rand -base64 48 and openssl rand -base64 32) ---
JWT_SECRET=
# 32 bytes, base64 or hex. Encrypts users' AI keys. Back it up: without it, saved keys can't be read.
ENCRYPTION_KEY=
# true in production (HTTPS). false only for plain-http local development.
COOKIE_SECURE=true

# --- Accounts ---
# false: one person per install (the first visitor creates the account). true: anyone can sign up.
SIGNUP_ENABLED=false

# --- Email (login codes, password reset, reminders) ---
# log: emails are printed to the API log (local development). smtp: real email.
# Without SMTP, login has no email code and reminders show in the app only.
MAIL_TRANSPORT=log
MAIL_FROM=Jobsmith <jobs@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Files ---
# Generated PDFs, imports and exports. Outside any public folder; back it up with the database.
STORAGE_DIR=./storage

# --- AI (each user adds their own key in Settings → AI; these are only the default model names) ---
AI_MODEL_GEMINI=gemini-2.5-flash
AI_MODEL_OPENAI=gpt-5-mini
AI_MODEL_ANTHROPIC=claude-haiku-5-5
AI_TIMEOUT_MS=60000

# --- Demo (the public demo site only) ---
DEMO_MODE=false
